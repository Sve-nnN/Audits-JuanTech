# Postgres connection string (Neon). Neon requires `sslmode=require` in the URL.
# Example: postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Redis connection string (Upstash). Upstash requires TLS, so the scheme must be
# `rediss://` (double "s"), not `redis://`. BullMQ is configured to auto-detect TLS
# from this scheme (see packages/queue/src/connection.ts).
# Example: rediss://default:password@xxxx.upstash.io:6379
REDIS_URL=rediss://default:password@host:6379

# Optional Google PageSpeed Insights API key (Phase 5). Without it, PSI is
# called keyless (low quota, ~1 req/s) — fine for the small representative
# sample this app runs per audit. Set this to raise the quota; no code
# changes needed, @auditor/psi picks it up automatically.
# https://developers.google.com/speed/docs/insights/v5/get-started
PSI_API_KEY=
