generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuditStatus {
  queued
  running
  done
  failed
}

enum IssueSeverity {
  critical
  warning
  ok
}

model Email {
  id               String   @id @default(cuid())
  address          String   @unique
  normalizedAddress String  @unique
  verified         Boolean  @default(false)
  verifiedAt       DateTime?
  consentIp        String?
  consentTextShown String?
  consentAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  audits      Audit[]
  quotaUsages QuotaUsage[]
}

model Site {
  id        String   @id @default(cuid())
  domain    String   @unique
  createdAt DateTime @default(now())

  audits Audit[]
}

model Audit {
  id        String      @id @default(cuid())
  siteId    String
  site      Site        @relation(fields: [siteId], references: [id])
  emailId   String?
  email     Email?      @relation(fields: [emailId], references: [id])
  status    AuditStatus @default(queued)
  urlLimit  Int         @default(500)
  stats     Json?
  /**
   * Scoring snapshot computed at audit completion (Phase 6, SCORE-01..05):
   * overall score/status, per-category scores/status, and a resolved-issues
   * summary from the diff against the previous completed audit of the same
   * site. Shape: { overall, status, byCategory: { [category]: { score, status } },
   * diff: { newCount, persistentCount, resolvedCount, resolvedFingerprints } }.
   */
  scores    Json?
  error     String?
  createdAt DateTime    @default(now())
  startedAt DateTime?
  finishedAt DateTime?

  pages      Page[]
  issues     Issue[]
  perfMetrics PerfMetric[]

  @@index([siteId])
  @@index([emailId])
}

model Page {
  id            String    @id @default(cuid())
  auditId       String
  audit         Audit     @relation(fields: [auditId], references: [id])
  url           String
  statusCode    Int?
  html          String?   @db.Text
  finalUrl      String?
  redirectChain Json?
  contentType   String?
  depth         Int?
  fromSitemap   Boolean   @default(false)
  fetchedAt     DateTime?
  error         String?
  createdAt     DateTime  @default(now())
  /** Entity graph built from this page's JSON-LD (schema.org): { nodes, edges } — Phase 4. */
  schemaGraph   Json?

  issues      Issue[]
  perfMetrics PerfMetric[]

  @@unique([auditId, url])
}

model Issue {
  id              String        @id @default(cuid())
  auditId         String
  audit           Audit         @relation(fields: [auditId], references: [id])
  pageId          String?
  page            Page?         @relation(fields: [pageId], references: [id])
  checkId         String
  category        String
  title           String
  severity        IssueSeverity
  fingerprint     String
  measuredValue   String?
  source          String?
  criterion       String?
  scope           String?
  recommendation  String?
  /** Diff vs the previous completed audit of the same site (Phase 6, DIFF-01/02): 'new' | 'persistent' | 'resolved'. Null until a diff has been computed (e.g. first audit of a site). */
  diffStatus      String?
  createdAt       DateTime      @default(now())

  @@index([auditId])
  @@index([pageId])
}

/**
 * Google PageSpeed Insights result for one crawled page + strategy
 * (Phase 5: PERF-01..04). Only a small representative sample of pages gets
 * PSI runs (see @auditor/psi `selectSample`), never the full crawl.
 */
model PerfMetric {
  id               String   @id @default(cuid())
  auditId          String
  audit            Audit    @relation(fields: [auditId], references: [id])
  pageId           String?
  page             Page?    @relation(fields: [pageId], references: [id])
  url              String
  strategy         String
  performanceScore Int?
  lcpMs            Int?
  cls              Float?
  inpMs            Int?
  ttfbMs           Int?
  fromCache        Boolean  @default(false)
  error            String?
  fetchedAt        DateTime @default(now())

  @@index([auditId])
  @@index([pageId])
}

model QuotaUsage {
  id        String   @id @default(cuid())
  emailId   String
  email     Email    @relation(fields: [emailId], references: [id])
  weekStart DateTime
  count     Int      @default(0)

  @@unique([emailId, weekStart])
}
